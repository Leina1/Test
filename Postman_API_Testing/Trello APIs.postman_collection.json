  "item": [
    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var JSONData = pm.response.json();",
              "",
              "pm.environment.set(\"BoardID\", JSONData.id);",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has id property\", function () {",
              "    pm.expect(JSONData).to.have.property(\"id\");",
              "    pm.expect(JSONData.id).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"Response has name property\", function () {",
              "    pm.expect(JSONData).to.have.property(\"name\");",
              "    pm.expect(JSONData.name).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"Response has url property\", function () {",
              "    pm.expect(JSONData).to.have.property(\"url\");",
              "    pm.expect(JSONData.url).to.be.a(\"string\").and.not.empty;",
              "});",
              "let CreatedBoardName = pm.environment.get(\"BoardName\");",
              "pm.test(\"Correct BoardName\", function () {",
              "    pm.expect(JSONData.name).to.eql(CreatedBoardName)",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomBoardName = `Board-${Date.now()}-${Math.floor(Math.random() * 1000)}`;\r",
              "pm.environment.set(\"BoardName\", randomBoardName);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
